# ========================================================
# FreightTiger Smart Shipping Cost Assistant Configuration
# ========================================================

# Optional: LLM API key for generating AI-augmented explanations.
# If not provided, the pipeline automatically uses the deterministic,
# verifiable explanation generator with zero hallucination.
GROQ_API_KEY=
OPENAI_API_KEY=

# Model provider and model name (e.g. 'groq:llama-3.3-70b-versatile', 'deterministic')
LLM_PROVIDER=deterministic
LLM_MODEL=none

# Pipeline configuration
HISTORICAL_ROLLING_WEEKS=8
HISTORICAL_DIFF_THRESHOLD_PCT=15.0
PEER_DIFF_THRESHOLD_PCT=20.0
OUTPUT_MODE=all
